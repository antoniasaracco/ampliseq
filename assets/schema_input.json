{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Ampliseq - Single Schema Supporting Both Formats",
    "description": "Schema supporting both legacy and standardized formats",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Legacy sample ID cannot contain spaces"
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Legacy FastQ file for reads 1 must have extension '.fq.gz' or '.fastq.gz'"
            },
            "fastq_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Legacy FastQ file for reads 2 must have extension '.fq.gz' or '.fastq.gz'"
            },
            "sampleID": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]+$",
                "errorMessage": "Standardized sample ID must start with a letter and contain only letters, numbers, or underscores",
                "meta": [
                    "sample"
                ]
            },
            "forwardReads": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Standardized forward reads must have extension '.fq.gz' or '.fastq.gz'"
            },
            "reverseReads": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Standardized reverse reads must have extension '.fq.gz' or '.fastq.gz'"
            },
            "run": {
                "type": [
                    "string",
                    "integer"
                ],
                "pattern": "^\\S+$",
                "errorMessage": "Run name cannot contain spaces",
                "meta": [
                    "run"
                ],
                "default": "1"
            },
            "control": {
                "type": [
                    "string"
                ],
                "enum": [
                    "control",
                    "sample"
                ],
                "errorMessage": "Must be 'control' or 'sample'",
                "meta": [
                    "control"
                ]
            },
            "quant_reading": {
                "type": [
                    "number"
                ],
                "errorMessage": "Quantification must be a number",
                "meta": [
                    "quant_reading"
                ]
            }
        },
        "anyOf": [
            {
                "comment": "Legacy format: must have sample and fastq_1",
                "required": [
                    "sample",
                    "fastq_1"
                ],
                "not": {
                    "anyOf": [
                        {
                            "required": [
                                "sampleID"
                            ]
                        },
                        {
                            "required": [
                                "forwardReads"
                            ]
                        }
                    ]
                }
            },
            {
                "comment": "Standardized format: must have sampleID and forwardReads",
                "required": [
                    "sampleID",
                    "forwardReads"
                ],
                "not": {
                    "anyOf": [
                        {
                            "required": [
                                "sample"
                            ]
                        },
                        {
                            "required": [
                                "fastq_1"
                            ]
                        }
                    ]
                }
            }
        ],
        "dependentRequired": {
            "fastq_2": [
                "fastq_1"
            ],
            "reverseReads": [
                "forwardReads"
            ]
        }
    }
}